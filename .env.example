# ── Backend ─────────────────────────────────────────────────────
APP_SECRET=               # Chave secreta para assinatura do JWT (gere uma string aleatória de segurança)

# ── Banco de Dados ──────────────────────────────────────────────
DATABASE_URL=             # String de conexão MySQL (mysql://usuario:senha@host:3306/nome_banco)

# ── Admin (o primeiro usuário registrado torna-se admin por padrão) ──
ADMIN_EMAIL=              # E-mail do usuário administrador (opcional)

# ── E-mail (Resend - serviço de envio de e-mails) ───────────────
RESEND_API_KEY=           # Chave de API do Resend (obtenha em https://resend.com)
RESEND_FROM_EMAIL=        # Endereço de remetente (ex: VoluntaRIO <onboarding@resend.dev>)

# ── Frontend ────────────────────────────────────────────────────
FRONTEND_URL=             # URL base do Frontend (padrão: http://localhost:3000)
VITE_GOOGLE_CLIENT_ID=    # Client ID do Google OAuth (o mesmo usado pelo backend, exposto ao frontend)
